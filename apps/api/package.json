{
  "name": "@ckb-automata/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node src/database/cli.ts up",
    "db:rollback": "node src/database/cli.ts down",
    "start": "node dist/main.js",
    "test": "node --test src/**/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 integration/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ckb-automata/config": "workspace:*",
    "@ckb-automata/core": "workspace:*",
    "@ckb-automata/molecule": "workspace:*",
    "@ckb-automata/telemetry": "workspace:*",
    "@ckb-ccc/shell": "1.3.13",
    "@nervosnetwork/ckb-sdk-utils": "0.109.5",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-fastify": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@ckb-automata/testing": "workspace:*",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1"
  }
}
