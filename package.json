{
  "name": "ckb-automata",
  "version": "0.0.0",
  "private": true,
  "description": "Non-custodial CKB automation showcase",
  "engines": {
    "node": "24.11.1",
    "pnpm": "12.5.1"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "check:versions": "node scripts/check-versions.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:workspace": "pnpm check:versions && pnpm check:workspace && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "24.11.1",
    "typescript": "7.0.2"
  }
}
